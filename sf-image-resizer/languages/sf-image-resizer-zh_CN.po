msgstr ""

#. Description of the plugin
#: sf-image-resizer.php
msgid "On-demand image resizing, cropping and WebP/JPG conversion for theme developers, straight from PHP templates, with automatic disk caching."
msgstr "面向主题开发者的按需图片缩放、裁剪与 WebP/JPG 转换，直接在 PHP 模板中调用，并自动缓存到磁盘。"

#. Author of the plugin
#: sf-image-resizer.php
msgid "saytformat"
msgstr ""

#: admin/class-sfir-admin.php:107
msgid "Delete every cached image? They will be regenerated on demand."
msgstr "删除所有缓存图片？它们会在需要时重新生成。"

#: admin/class-sfir-admin.php:108
msgid "Clear the error log?"
msgstr "清空错误日志？"

#: admin/class-sfir-admin.php:113
#: admin/class-sfir-admin.php:480
msgid "Pretty URLs are working."
msgstr "简洁网址工作正常。"

#: admin/class-sfir-admin.php:114
msgid "Checked from your browser just now."
msgstr "刚刚从你的浏览器完成检测。"

#: admin/class-sfir-admin.php:115
msgid "Copied"
msgstr "已复制"

#: admin/class-sfir-admin.php:116
msgid "Press Ctrl+C to copy"
msgstr "按 Ctrl+C 复制"

#. translators: %d: number of deleted files.
