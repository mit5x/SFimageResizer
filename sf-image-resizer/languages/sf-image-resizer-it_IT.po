msgid "SF Image resizer"
msgstr ""

#. Plugin URI of the plugin
#. Author URI of the plugin
#: sf-image-resizer.php
msgid "https://web-format.net"
msgstr ""

#. Description of the plugin
#: sf-image-resizer.php
msgid "On-demand image resizing, cropping and WebP/JPG conversion for theme developers, straight from PHP templates, with automatic disk caching."
msgstr "Ridimensionamento, ritaglio e conversione in WebP/JPG su richiesta per chi sviluppa temi, direttamente dai template PHP e con cache automatica su disco."

#. Author of the plugin
#: sf-image-resizer.php
msgid "saytformat"
msgstr ""

#: admin/class-sfir-admin.php:108
msgid "Delete every cached image? They will be regenerated on demand."
msgstr "Eliminare tutte le immagini in cache? Verranno ricreate quando serviranno."

#: admin/class-sfir-admin.php:109
msgid "Clear the error log?"
msgstr "Svuotare il registro degli errori?"

#: admin/class-sfir-admin.php:114
#: admin/class-sfir-admin.php:501
msgid "Pretty URLs are working."
msgstr "Gli URL puliti funzionano."

#: admin/class-sfir-admin.php:115
msgid "Checked from your browser just now."
msgstr "Verificato in questo momento dal tuo browser."

#: admin/class-sfir-admin.php:116
msgid "Copied"
msgstr "Copiato"

#: admin/class-sfir-admin.php:117
msgid "Press Ctrl+C to copy"
msgstr "Premi Ctrl+C per copiare"

#. translators: %d: number of deleted files.
#: admin/class-sfir-admin.php:140
#, php-format
msgid "%d cached file deleted."
msgid_plural "%d cached files deleted."
msgstr[0] "%d file in cache eliminato."
msgstr[1] "%d file in cache eliminati."

#: admin/class-sfir-admin.php:161
msgid "The error log has been cleared."
msgstr "Il registro degli errori è stato svuotato."

#: admin/class-sfir-admin.php:162
msgid "The error log could not be cleared."
msgstr "Non è stato possibile svuotare il registro degli errori."

#: admin/class-sfir-admin.php:179
msgid "The check was reset and will run again from your browser."
msgstr "La verifica è stata azzerata e verrà eseguita di nuovo dal tuo browser."

#: admin/class-sfir-admin.php:219
msgid "The generation mode has been saved."
msgstr "La modalità di creazione è stata salvata."

#: admin/class-sfir-admin.php:232
#: admin/class-sfir-admin.php:343
#: includes/class-sfir-diagnostics.php:131
msgid "You are not allowed to do this."
msgstr "Non hai i permessi per farlo."

#: admin/class-sfir-admin.php:300
#: admin/class-sfir-admin.php:423
msgid "Cache"
msgstr "Cache"

#: admin/class-sfir-admin.php:301
msgid "Check and log"
msgstr "Verifica e registro"

#: admin/class-sfir-admin.php:302
#: admin/class-sfir-admin.php:648
msgid "Documentation"
msgstr "Documentazione"

#: admin/class-sfir-admin.php:397
msgid "Language of this screen"
msgstr "Lingua di questa pagina"

#: admin/class-sfir-admin.php:405
msgid "Apply"
msgstr "Applica"

#: admin/class-sfir-admin.php:427
msgid "Cached files"
msgstr "File in cache"

#: admin/class-sfir-admin.php:432
#: admin/class-sfir-admin.php:444
msgid "(approximate)"
msgstr "(approssimativo)"

#: admin/class-sfir-admin.php:438
msgid "Total size"
msgstr "Dimensione totale"

#. translators: %s: cache size in megabytes.
#: admin/class-sfir-admin.php:442
#, php-format
msgid "%s MB"
msgstr "%s MB"

#: admin/class-sfir-admin.php:450
msgid "Cache directory"
msgstr "Cartella della cache"

#: admin/class-sfir-admin.php:454
msgid "WebP output"
msgstr "Output WebP"

#: admin/class-sfir-admin.php:458
msgid "Supported by this server."
msgstr "Supportato da questo server."

#: admin/class-sfir-admin.php:459
msgid "Not available: this GD build has no WebP support, JPG is produced instead."
msgstr "Non disponibile: questa build di GD non supporta WebP, viene prodotto JPG."

#: admin/class-sfir-admin.php:466
msgid "Deleting the cache is safe: every copy is created again the first time a browser asks for it."
msgstr "Svuotare la cache è sicuro: ogni copia viene ricreata alla prima richiesta di un browser."

#: admin/class-sfir-admin.php:471
msgid "Clear image cache"
msgstr "Svuota la cache delle immagini"

#: admin/class-sfir-admin.php:493
msgid "Configuration check"
msgstr "Verifica della configurazione"

#: admin/class-sfir-admin.php:495
msgid "Image URLs point straight at the cache file. While that file does not exist yet, the web server has to hand the request to WordPress so the plugin can create it."
msgstr "Gli URL delle immagini puntano direttamente al file in cache. Finché quel file non esiste, il web server deve passare la richiesta a WordPress perché il plugin possa crearlo."

#. translators: %s: date and time of the last confirmation.
#: admin/class-sfir-admin.php:505
#, php-format
msgid "Confirmed by a real request on %s."
msgstr "Confermato da una richiesta reale il %s."

#: admin/class-sfir-admin.php:512
msgid "Not confirmed automatically yet."
msgstr "Non ancora confermato automaticamente."

#: admin/class-sfir-admin.php:513
msgid "This is often caused by the hosting bot protection and does not mean anything is broken. Check it yourself: open the URL of any size that has not been generated yet in your browser. If the image appears, everything works."
msgstr "Spesso dipende dalla protezione anti-bot dell’hosting e non significa che qualcosa sia rotto. Verifica tu stesso: apri nel browser l’URL di una dimensione non ancora generata. Se l’immagine compare, funziona tutto."

#: admin/class-sfir-admin.php:517
msgid "If images really are not being created"
msgstr "Se le immagini davvero non vengono create"

#: admin/class-sfir-admin.php:518
msgid "On nginx, add this to the server configuration and reload it. Your host can apply it for you:"
msgstr "Su nginx aggiungi questo alla configurazione del server e ricaricala. Il tuo hosting può farlo per te:"

#: admin/class-sfir-admin.php:520
msgid "On Apache, make sure .htaccess files are honoured (AllowOverride All) for the uploads directory."
msgstr "Su Apache verifica che i file .htaccess vengano considerati (AllowOverride All) per la cartella uploads."

#: admin/class-sfir-admin.php:528
msgid "Check again"
msgstr "Verifica di nuovo"

#: admin/class-sfir-admin.php:533
msgid "Error log"
msgstr "Registro degli errori"

#: admin/class-sfir-admin.php:535
msgid "The 50 first lines of the log file are shown below."
msgstr "Qui sotto sono mostrate le prime 50 righe del file di registro."

#: admin/class-sfir-admin.php:538
msgid "The log is empty."
msgstr "Il registro è vuoto."

#: admin/class-sfir-admin.php:543
msgid "Clear log"
msgstr "Svuota il registro"

#: admin/class-sfir-admin.php:558
msgid "When copies are produced"
msgstr "Quando vengono create le copie"

#: admin/class-sfir-admin.php:560
msgid "If your host cannot be configured to hand a missing cache file to WordPress, let the plugin produce the copies while the page is rendered. The first visit to each page is then slower, and every visit after that is served straight from disk."
msgstr "Se il tuo host non può essere configurato per passare a WordPress un file di cache mancante, lascia che il plugin crei le copie durante il rendering della pagina. La prima visita a ogni pagina sarà più lenta, tutte le successive verranno servite direttamente dal disco."

#: admin/class-sfir-admin.php:582
msgid "Right now: copies are produced while the page is rendered."
msgstr "In questo momento: le copie vengono create durante il rendering della pagina."

#: admin/class-sfir-admin.php:583
msgid "Right now: copies are produced the first time a browser asks for them."
msgstr "In questo momento: le copie vengono create alla prima richiesta di un browser."

#: admin/class-sfir-admin.php:589
msgid "Save"
msgstr "Salva"

#: admin/class-sfir-admin.php:602
msgid "Pick this when the check above keeps failing and the server configuration cannot be changed. Works everywhere, including nginx without the rewrite rule."
msgstr "Scegli questa opzione quando il controllo qui sopra continua a fallire e la configurazione del server non può essere modificata. Funziona ovunque, anche su nginx senza la regola di riscrittura."

#: admin/class-sfir-admin.php:606
msgid "The lightest option for page rendering, but it needs the web server to pass requests for missing files to WordPress."
msgstr "L’opzione più leggera per il rendering della pagina, ma richiede che il web server inoltri a WordPress le richieste dei file mancanti."

#: admin/class-sfir-admin.php:609
msgid "Produce copies while rendering until the check above confirms that requests for missing files reach the plugin, then stop. Recommended."
msgstr "Crea le copie durante il rendering finché il controllo qui sopra non conferma che le richieste dei file mancanti raggiungono il plugin, poi smetti. Consigliato."

#: admin/class-sfir-admin.php:650
msgid "Call these functions from your theme templates. They never throw and never break a page: on error they return an SVG placeholder and write one line to the log."
msgstr "Richiama queste funzioni dai template del tuo tema. Non sollevano mai eccezioni e non rompono mai una pagina: in caso di errore restituiscono un segnaposto SVG e scrivono una riga nel registro."

#: admin/class-sfir-admin.php:652
msgid "Functions"
msgstr "Funzioni"

#: admin/class-sfir-admin.php:656
msgid "Function"
msgstr "Funzione"

#: admin/class-sfir-admin.php:657
#: admin/class-sfir-admin.php:694
msgid "Description"
msgstr "Descrizione"

#: admin/class-sfir-admin.php:663
msgid "Returns the URL of the resized copy. Output it with esc_url()."
msgstr "Restituisce l’URL della copia ridimensionata. Stampalo con esc_url()."

#: admin/class-sfir-admin.php:667
msgid "Returns the width the copy will have, calculated without generating it."
msgstr "Restituisce la larghezza che avrà la copia, calcolata senza generarla."

#: admin/class-sfir-admin.php:671
msgid "Returns the matching height."
msgstr "Restituisce l’altezza corrispondente."

#: admin/class-sfir-admin.php:675
msgid "Returns a complete srcset for 320, 640, 960, 1280, 1920 and 2560 pixels. Output it with esc_attr()."
msgstr "Restituisce un srcset completo per 320, 640, 960, 1280, 1920 e 2560 pixel. Stampalo con esc_attr()."

#: admin/class-sfir-admin.php:679
msgid "Returns a complete img tag with src, width, height, loading=\"lazy\" and decoding=\"async\". Attributes in $attrs override the defaults."
msgstr "Restituisce un tag img completo con src, width, height, loading=\"lazy\" e decoding=\"async\". Gli attributi in $attrs sostituiscono quelli predefiniti."

#: admin/class-sfir-admin.php:684
msgid "Sources"
msgstr "Sorgenti"

#: admin/class-sfir-admin.php:685
msgid "$source accepts a URL belonging to this site, an attachment ID, or an ACF image array. Anything else, including URLs on other hosts, produces a placeholder."
msgstr "$source accetta un URL di questo sito, un ID allegato o un array immagine di ACF. Qualsiasi altra cosa, inclusi URL su altri domini, produce un segnaposto."

#: admin/class-sfir-admin.php:687
msgid "Parameters"
msgstr "Parametri"

#: admin/class-sfir-admin.php:691
msgid "Parameter"
msgstr "Parametro"

#: admin/class-sfir-admin.php:692
msgid "Values"
msgstr "Valori"

#: admin/class-sfir-admin.php:693
msgid "Default"
msgstr "Predefinito"

#: admin/class-sfir-admin.php:702
msgid "Maximum width in pixels. 0 means \"not constrained\"."
msgstr "Larghezza massima in pixel. 0 significa «senza vincolo»."

#: admin/class-sfir-admin.php:708
msgid "Maximum height in pixels. 0 means \"not constrained\"."
msgstr "Altezza massima in pixel. 0 significa «senza vincolo»."

#: admin/class-sfir-admin.php:714
msgid "Output format."
msgstr "Formato di output."

#: admin/class-sfir-admin.php:720
msgid "Output quality."
msgstr "Qualità di output."

#: admin/class-sfir-admin.php:724
msgid "3 or 6 hex digits, without \"#\""
msgstr "3 o 6 cifre esadecimali, senza «#»"

#: admin/class-sfir-admin.php:725
msgid "transparent, FFFFFF for JPG"
msgstr "trasparente, FFFFFF per JPG"

#: admin/class-sfir-admin.php:726
msgid "Background colour used to fill transparent areas."
msgstr "Colore di sfondo con cui riempire le aree trasparenti."

#: admin/class-sfir-admin.php:732
msgid "Crop to exactly w x h, centred. Ignored unless both w and h are set."
msgstr "Ritaglia esattamente a w x h, centrato. Ignorato se non sono impostati entrambi i lati."

#: admin/class-sfir-admin.php:737
msgid "Images are never enlarged. If the source is smaller than the request, the result keeps the source size; with crop=1 it is cropped to the largest region matching the requested ratio."
msgstr "Le immagini non vengono mai ingrandite. Se l’originale è più piccolo di quanto richiesto, il risultato mantiene la dimensione dell’originale; con crop=1 viene ritagliato sulla regione più grande che rispetta le proporzioni richieste."

#: admin/class-sfir-admin.php:739
msgid "Examples"
msgstr "Esempi"

#: admin/class-sfir-admin.php:744
msgid "1. A plain image URL:"
msgstr "1. Un semplice URL di immagine:"

#: admin/class-sfir-admin.php:751
msgid "2. An attachment ID, cropped to a fixed box:"
msgstr "2. Un ID allegato, ritagliato a una dimensione fissa:"

#: admin/class-sfir-admin.php:755
msgid "3. An ACF image field, flattened onto a white background as JPG:"
msgstr "3. Un campo immagine ACF, appiattito su sfondo bianco in JPG:"

#: admin/class-sfir-admin.php:784
msgid "4. A universal responsive srcset"
msgstr "4. Un srcset responsive universale"

#: admin/class-sfir-admin.php:785
msgid "This is the recommended way to output a responsive image, and it covers almost every case. sf_img_srcset() builds the whole srcset for you at 320, 640, 960, 1280, 1920 and 2560 pixels, so nothing has to be added to your theme functions.php. Everything else in the tag stays yours to write."
msgstr "È il modo consigliato per mostrare un’immagine responsive e copre quasi tutti i casi. sf_img_srcset() costruisce l’intero srcset per 320, 640, 960, 1280, 1920 e 2560 pixel, quindi non serve aggiungere nulla al functions.php del tema. Tutto il resto del tag lo scrivi tu."

#: admin/class-sfir-admin.php:787
msgid "The variable may be called anything: it is just the first argument. Widths the source is too small for are skipped, and every candidate is labelled with the width the file really has, so the browser is never told that a 1600 pixel copy is 2560 pixels wide."
msgstr "La variabile può avere qualsiasi nome: è semplicemente il primo argomento. Le larghezze per cui l’originale è troppo piccolo vengono saltate e ogni candidato riporta la larghezza reale del file, così al browser non viene mai detto che una copia da 1600 pixel ne misura 2560."

#: admin/class-sfir-admin.php:788
msgid "sizes=\"auto\" lets the browser measure the image itself, and it requires loading=\"lazy\". For an image above the fold, drop the lazy loading and write sizes yourself, for example sizes=\"100vw\"."
msgstr "sizes=\"auto\" lascia che sia il browser a misurare l’immagine e richiede loading=\"lazy\". Per un’immagine subito visibile togli il caricamento differito e scrivi sizes a mano, ad esempio sizes=\"100vw\"."

#: admin/class-sfir-admin.php:790
msgid "5. A custom responsive srcset"
msgstr "5. Un srcset responsive su misura"

#: admin/class-sfir-admin.php:791
msgid "Use this variant only when you know exactly what size the image is rendered at in each place of your site, and want to control the widths and the sizes attribute yourself. In every other case example 4 is simpler and harder to get wrong."
msgstr "Usa questa variante solo se sai esattamente a che dimensione viene mostrata l’immagine in ogni punto del sito e vuoi controllare tu le larghezze e l’attributo sizes. In tutti gli altri casi l’esempio 4 è più semplice e più difficile da sbagliare."

#: admin/class-sfir-admin.php:794
msgid "Error codes"
msgstr "Codici di errore"

#: admin/class-sfir-admin.php:798
msgid "Code"
msgstr "Codice"

#: admin/class-sfir-admin.php:799
msgid "Meaning"
msgstr "Significato"

#: admin/class-sfir-admin.php:812
msgid "How the URL is built"
msgstr "Come è costruito l’URL"

#: admin/class-sfir-admin.php:813
msgid "Cached copies mirror the directory tree of their source inside the cache directory, and the file name carries the parameters plus a short signature:"
msgstr "Le copie in cache rispecchiano l’albero delle cartelle dell’originale dentro la cartella della cache, e il nome del file contiene i parametri più una breve firma:"

#: admin/class-sfir-admin.php:817
msgid "The bg part appears only when a background colour was requested. The hash is six hexadecimal characters of an HMAC over the source path and the parameters; it lets the plugin create only the sizes your templates actually ask for, and cannot be guessed to fill the disk."
msgstr "La parte bg compare solo se è stato richiesto un colore di sfondo. L’hash è composto da sei caratteri esadecimali di un HMAC sul percorso dell’originale e sui parametri: permette di creare soltanto le dimensioni che i tuoi template richiedono davvero e non può essere indovinato per riempire il disco."

#: admin/class-sfir-admin.php:820
msgid "Notes"
msgstr "Note"

#: admin/class-sfir-admin.php:822
msgid "WebP fallback: if this PHP build has no WebP support, JPG is produced instead and the cached file gets a .jpg extension. A single notice is written to the log."
msgstr "Ripiego su WebP: se questa build di PHP non supporta WebP viene prodotto JPG e il file in cache riceve l’estensione .jpg. Nel registro viene scritta una sola nota."

#: admin/class-sfir-admin.php:823
msgid "Animated GIF: only the first frame is used, animation is not preserved."
msgstr "GIF animata: viene usato solo il primo fotogramma, l’animazione non è conservata."

#: admin/class-sfir-admin.php:824
msgid "SVG files are not accepted as input."
msgstr "I file SVG non sono accettati come sorgente."

#: admin/class-sfir-admin.php:825
msgid "Every call returns the same plain URL of the cached file, from the very first render. When that file does not exist yet, the request falls through to WordPress and the plugin generates it; afterwards the web server serves it as a static file and PHP is no longer involved."
msgstr "Ogni chiamata restituisce sempre lo stesso URL semplice del file in cache, fin dal primo render. Finché quel file non esiste la richiesta arriva a WordPress e il plugin lo genera; poi il web server lo serve come file statico e PHP non è più coinvolto."

#: admin/class-sfir-admin.php:826
msgid "On nginx, .htaccess files are ignored. Deny direct access to the logs directory in your server configuration."
msgstr "Su nginx i file .htaccess vengono ignorati. Nega l’accesso diretto alla cartella logs nella configurazione del server."

#: admin/class-sfir-admin.php:845
msgid "Reference for an AI assistant"
msgstr "Riferimento per un assistente IA"

#: admin/class-sfir-admin.php:846
msgid "The whole reference below is written for a language model. Copy it into Claude, ChatGPT or any other assistant together with your own template, and it will have everything it needs to output correct src and srcset markup with this plugin."
msgstr "L’intero riferimento qui sotto è scritto per un modello linguistico. Copialo in Claude, ChatGPT o un altro assistente insieme al tuo template: avrà tutto il necessario per produrre il markup corretto di src e srcset con questo plugin."

#: admin/class-sfir-admin.php:851
msgid "Copy"
msgstr "Copia"

#: admin/class-sfir-admin.php:855
msgid "Download .md"
msgstr "Scarica il .md"

#: includes/class-sfir-diagnostics.php:141
msgid "Pretty URLs are working — checked from your browser just now."
msgstr "Gli URL puliti funzionano: verificato in questo momento dal tuo browser."

#: includes/class-sfir-generator.php:76
msgid "Automatic"
msgstr "Automatico"

#: includes/class-sfir-generator.php:77
msgid "Always, while the page is rendered"
msgstr "Sempre, durante il rendering della pagina"

#: includes/class-sfir-generator.php:78
msgid "Never: only when a browser asks for the file"
msgstr "Mai: solo quando un browser richiede il file"

#: includes/class-sfir-i18n.php:47
msgid "Site language"
msgstr "Lingua del sito"

#: includes/class-sfir-placeholder.php:36
msgid "Source file not found, or path outside the allowed directories."
msgstr "File di origine non trovato, o percorso fuori dalle cartelle consentite."

#: includes/class-sfir-placeholder.php:37
msgid "Unsupported or unrecognised input file format."
msgstr "Formato del file di ingresso non supportato o non riconosciuto."

#: includes/class-sfir-placeholder.php:38
msgid "External URL or disallowed scheme."
msgstr "URL esterno o schema non consentito."

#: includes/class-sfir-placeholder.php:39
msgid "Invalid request parameters or invalid signature."
msgstr "Parametri della richiesta o firma non validi."

#: includes/class-sfir-placeholder.php:40
msgid "GD processing error."
msgstr "Errore di elaborazione GD."

#: includes/class-sfir-placeholder.php:41
msgid "Cache directory is not writable."
msgstr "La cartella della cache non è scrivibile."

#: includes/class-sfir-placeholder.php:42
msgid "Image is too large to process (memory or pixel limit)."
msgstr "Immagine troppo grande da elaborare (limite di memoria o di pixel)."

#: includes/class-sfir-placeholder.php:121
msgid "Image error"
msgstr "Errore immagine"

#: sf-image-resizer.php:118
msgid "Settings"
msgstr "Impostazioni"
