{
	"name": "saytformat/sf-image-resizer",
	"description": "Development tooling for the SFimageResizer WordPress plugin. The plugin itself has no Composer dependencies.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "saytformat",
			"homepage": "https://web-format.net"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.0"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs --standard=phpcs.xml.dist",
		"lint:fix": "phpcbf --standard=phpcs.xml.dist"
	}
}
